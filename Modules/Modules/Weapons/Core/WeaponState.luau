export type Vars = typeof(makeDefaults())

local vars: Vars = makeDefaults()

function WeaponState.get(): Vars
	return vars
end

function WeaponState.reset(): Vars
	local target = vars :: any
	for key in pairs(target) do
		target[key] = nil
	end
	for key, value in pairs(makeDefaults() :: any) do
		target[key] = value
	end
	return vars
end

return WeaponState
