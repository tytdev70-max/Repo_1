Modules["Util"] = function(require)
	--[[
		Util.luau
		---------
		Shared, dependency-free helpers used by every module of the AnimSaves
		Bulk Uploader plugin.

		Nothing in this module touches Roblox instances, so it can be unit-tested
		in isolation and reused by the command-bar version of the tool.

		Contents
		1. mulMod32          - exact (a * b) mod 2^32 for doubles (16-bit limbs)
		2. fnv1a32 / djb2    - two independent, streamable 32-bit hashes
		3. base64url         - JSON/XML-safe text encoding for binary blobs
		4. hex               - fallback text encoding (used only if base64 fails)
		5. formatting helpers
		6. table helpers
	]]

	local Util = {}

	local TWO_POW_32 = 4294967296 -- 2^32

	--------------------------------------------------------------------------------
	-- 1. Exact 32-bit modular multiplication
	--------------------------------------------------------------------------------

	--[[
		Luau numbers are IEEE-754 doubles, so they are only exact up to 2^53.
		A naive `(a * b) % 2^32` silently loses precision once a * b > 2^53,
		which corrupts hashes. We therefore split `a` into two 16-bit limbs and
		multiply each limb separately; every intermediate product stays below
		2^48 and is therefore exact.
	]]
	local function mulMod32(a: number, b: number): number
		local aHi = math.floor(a / 65536)
		local aLo = a % 65536
		local hi = (aHi * b) % TWO_POW_32
		local lo = (aLo * b) % TWO_POW_32
		return (hi * 65536 + lo) % TWO_POW_32
	end

	Util.mulMod32 = mulMod32

	--------------------------------------------------------------------------------
	-- 2. Streaming hashes
	--------------------------------------------------------------------------------

	--[[
		FNV-1a (32-bit). Streamable: it can be fed one byte at a time, which lets
		BinaryCacheService hash multi-megabyte animations without ever building a
		giant intermediate string.

		Returns an integer in [0, 2^32).
	]]
	function Util.fnv1a32(bytes: string, seed: number?): number
		local h = seed or 0x811C9DC5
		local prime = 0x01000193
		for i = 1, #bytes do
			h = mulMod32(bit32.bxor(h, string.byte(bytes, i)), prime)
		end
		return h
	end

	--[[
		djb2-x. Also streamable, completely independent of FNV-1a.
		Packing *two* unrelated hashes gives a 64-bit effective digest, which makes
		an accidental collision between two different animations negligible.
	]]
	function Util.djb2(bytes: string, seed: number?): number
		local h = seed or 5381
		for i = 1, #bytes do
			h = (h * 33 + string.byte(bytes, i)) % TWO_POW_32
		end
		return h
	end

	--[[
		Convenience wrapper: returns both hashes for a byte string.
	]]
	function Util.hash64(bytes: string): (number, number)
		return Util.fnv1a32(bytes), Util.djb2(bytes)
	end

	--------------------------------------------------------------------------------
	-- 3. base64url - JSON / XML safe text encoding
	--------------------------------------------------------------------------------

	--[[
		Why this exists
		---------------
		`Plugin:SetSetting` stores values as JSON and Roblox instance string
		properties are serialized as XML text. Neither can carry raw binary bytes
		(0x00-0x1F, backslashes, quotes, ...). Every binary blob produced by
		BinaryCacheService is therefore encoded with base64url before it is stored.

		We use a URL-safe alphabet and drop '=' padding so the output contains only
		[A-Za-z0-9-_], which is safe in JSON strings, XML text and plugin setting keys.
	]]
	local B64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
	local B64_REVERSE: { [string]: number } = {}
	for i = 1, 64 do
		B64_REVERSE[B64_ALPHABET:sub(i, i)] = i - 1
	end

	--[[
		Encodes arbitrary bytes (including embedded NULs) as base64url text with
		standard '=' padding.

		The alphabet is URL-safe ([A-Za-z0-9-_]) so the result survives JSON and XML
		verbatim; '=' padding is safe in both.
	]]
	function Util.base64Encode(input: string): string
		local out = {}
		local n = #input
		local i = 1
		while i <= n do
			local b1 = string.byte(input, i)
			local b2 = string.byte(input, i + 1)
			local b3 = string.byte(input, i + 2)

			-- 6 bits of b1.
			out[#out + 1] = B64_ALPHABET:sub(bit32.rshift(b1, 2) + 1, bit32.rshift(b1, 2) + 1)

			-- Low 2 bits of b1 + high 4 bits of b2.
			local c2 = bit32.band(bit32.lshift(b1, 4), 0x30)
			if b2 then
				c2 = bit32.bor(c2, bit32.rshift(b2, 4))
			end
			out[#out + 1] = B64_ALPHABET:sub(c2 + 1, c2 + 1)

			if not b2 then
				-- 1 input byte left -> two padding chars.
				out[#out + 1] = "="
				out[#out + 1] = "="
				break
			end

			-- Low 4 bits of b2 + high 2 bits of b3.
			local c3 = bit32.band(bit32.lshift(b2, 2), 0x3C)
			if b3 then
				c3 = bit32.bor(c3, bit32.rshift(b3, 6))
			end
			out[#out + 1] = B64_ALPHABET:sub(c3 + 1, c3 + 1)

			if not b3 then
				-- 2 input bytes left -> one padding char.
				out[#out + 1] = "="
				break
			end

			-- Low 6 bits of b3.
			out[#out + 1] = B64_ALPHABET:sub(bit32.band(b3, 0x3F) + 1, bit32.band(b3, 0x3F) + 1)
			i += 3
		end
		return table.concat(out)
	end

	--[[
		Decodes base64url text back into raw bytes.

		Padding is honoured: a group ending in '=' yields fewer than three bytes.
		Errors on malformed input (bad length, invalid character, or '=' in a
		non-final group) rather than silently returning corrupted data.
	]]
	function Util.base64Decode(input: string): string
		if #input % 4 ~= 0 then
			error("Util.base64Decode: invalid base64 length " .. tostring(#input), 2)
		end

		local out = {}
		local n = #input
		local groups = n // 4

		for group = 0, groups - 1 do
			local base = group * 4
			local c1ch = input:sub(base + 1, base + 1)
			local c2ch = input:sub(base + 2, base + 2)
			local c3ch = input:sub(base + 3, base + 3)
			local c4ch = input:sub(base + 4, base + 4)

			local c1 = B64_REVERSE[c1ch]
			local c2 = B64_REVERSE[c2ch]
			if not (c1 and c2) then
				error("Util.base64Decode: invalid base64 character", 2)
			end

			-- '=' may only appear in the final group, and only as trailing chars.
			local lastGroup = group == groups - 1
			local pad3, pad4 = c3ch == "=", c4ch == "="
			if (pad3 or pad4) and not lastGroup then
				error("Util.base64Decode: padding character in a non-final group", 2)
			end
			if pad3 and not pad4 then
				error("Util.base64Decode: invalid padding", 2)
			end

			local c3 = if pad3 then 0 else B64_REVERSE[c3ch]
			local c4 = if pad4 then 0 else B64_REVERSE[c4ch]
			if c3 == nil or c4 == nil then
				error("Util.base64Decode: invalid base64 character", 2)
			end

			local v = bit32.bor(bit32.lshift(c1, 18), bit32.lshift(c2, 12), bit32.lshift(c3, 6), c4)

			out[#out + 1] = string.char(bit32.band(bit32.rshift(v, 16), 0xFF))
			if not pad3 then
				out[#out + 1] = string.char(bit32.band(bit32.rshift(v, 8), 0xFF))
			end
			if not pad4 then
				out[#out + 1] = string.char(bit32.band(v, 0xFF))
			end
		end

		return table.concat(out)
	end

	--------------------------------------------------------------------------------
	-- 4. hex encoding (fallback)
	--------------------------------------------------------------------------------

	local HEX = "0123456789abcdef"

	function Util.hexEncode(input: string): string
		local out = table.create(#input * 2)
		for i = 1, #input do
			local b = string.byte(input, i)
			out[i * 2 - 1] = HEX:sub(bit32.rshift(b, 4) + 1, bit32.rshift(b, 4) + 1)
			out[i * 2] = HEX:sub(bit32.band(b, 0x0F) + 1, bit32.band(b, 0x0F) + 1)
		end
		return table.concat(out)
	end

	function Util.hexDecode(input: string): string
		if #input % 2 ~= 0 then
			error("Util.hexDecode: odd length", 2)
		end
		local out = table.create(#input // 2)
		for i = 1, #input // 2 do
			local hi = HEX:find(input:sub(i * 2 - 1, i * 2 - 1), 1, true) - 1
			local lo = HEX:find(input:sub(i * 2, i * 2), 1, true) - 1
			out[i] = string.char(hi * 16 + lo)
		end
		return table.concat(out)
	end

	--[[
		Round-trip self test. Returns true when both encoders survive encode->decode.
		Called once by MainPlugin at startup; a failure downgrades the cache to the
		hex backend rather than crashing the plugin.
	]]
	function Util.selftestEncodings(): (boolean, boolean)
		-- Cover every padding path: lengths 0, 1, 2 mod 3 plus all 256 byte values.
		local samples = {
			"",
			"M",
			"Ma",
			"Man",
			string.char(0, 1, 2, 253, 254, 255, 65, 66, 67, 0, 10, 13, 34, 92),
		}
		for i = 0, 255 do
			samples[#samples + 1] = string.char(i)
			samples[#samples + 1] = string.char(i, i)
			samples[#samples + 1] = string.char(i, i, i)
		end

		local ok64, okHex = true, true
		for _, sample in ipairs(samples) do
			if Util.base64Decode(Util.base64Encode(sample)) ~= sample then
				ok64 = false
				break
			end
		end
		for _, sample in ipairs(samples) do
			if Util.hexDecode(Util.hexEncode(sample)) ~= sample then
				okHex = false
				break
			end
		end

		-- The alphabet must stay JSON/XML safe.
		local encoded = Util.base64Encode(table.concat(samples))
		for i = 1, #encoded do
			local b = string.byte(encoded, i)
			local safe = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 95 or b == 61
			if not safe then
				ok64 = false
				break
			end
		end

		return ok64, okHex
	end

	--------------------------------------------------------------------------------
	-- 5. Formatting helpers
	--------------------------------------------------------------------------------

	--[[
		Formats seconds as `m:ss.s` (e.g. 74.25 -> "1:14.2").
	]]
	function Util.formatDuration(seconds: number): string
		if not seconds or seconds ~= seconds or seconds < 0 then
			return "0:00.0"
		end
		local minutes = math.floor(seconds / 60)
		local secs = seconds - minutes * 60
		return string.format("%d:%04.1f", minutes, secs)
	end

	--[[
		Formats a byte count using binary-ish units.
	]]
	function Util.formatBytes(bytes: number): string
		if bytes < 1024 then
			return string.format("%d B", bytes)
		elseif bytes < 1024 * 1024 then
			return string.format("%.1f KB", bytes / 1024)
		end
		return string.format("%.2f MB", bytes / (1024 * 1024))
	end

	--[[
		Adds thousands separators: 1234567 -> "1,234,567".
	]]
	function Util.formatInt(value: number): string
		local s = tostring(math.floor(value))
		local out = s:reverse():gsub("(%d%d%d)", "%1,")
		-- gsub returns (string, count); reverse the padded result back
		local padded = out:reverse()
		return (padded:gsub("^,", ""))
	end

	--[[
		Normalises an asset id to the canonical `rbxassetid://<number>` form so the
		plugin can accept either "12345", "rbxassetid://12345" or "http://www.roblox.com/asset/?id=12345".
	]]
	function Util.normalizeAssetId(value: any): number?
		if typeof(value) == "number" then
			return math.floor(value)
		end
		if type(value) ~= "string" then
			return nil
		end
		local digits = value:match("(%d+)%s*$")
		if not digits then
			return nil
		end
		local id = tonumber(digits)
		return id and math.floor(id) or nil
	end

	function Util.assetIdToContent(id: number): string
		return "rbxassetid://" .. tostring(math.floor(id))
	end

	--------------------------------------------------------------------------------
	-- 6. Table helpers
	--------------------------------------------------------------------------------

	--[[
		Stable, case-insensitive sort key so the UI list order never jumps around
		between scans (Roblox's `GetChildren` order is not guaranteed).
	]]
	function Util.sortKey(name: string): string
		return name:lower()
	end

	--[[
		Shallow-copies an array.
	]]
	function Util.copyArray(source: { any }): { any }
		local out = table.create(#source)
		for i, v in ipairs(source) do
			out[i] = v
		end
		return out
	end

	--[[
		Returns true when `list` contains `value` (linear scan; lists are small).
	]]
	function Util.contains(list: { any }, value: any): boolean
		for _, v in ipairs(list) do
			if v == value then
				return true
			end
		end
		return false
	end

	--[[
		Escapes Lua pattern magic characters so a user-typed filter string can be
		used safely with string.find(..., _, true) alternatives.
	]]
	function Util.escapePattern(text: string): string
		return (text:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%1"))
	end

	return Util

end

Modules["RigScanner"] = function(require)
	--[[
		RigScanner.luau
		---------------
		Module 1 of 6 - the unified rig scanner.

		Responsibility
			* Locate the `AnimSaves` container inside a rig.
			* Resolve that container with ONE unified rule, no matter what class it is.
			* Collect every `KeyframeSequence` it exposes.
			* Return a structured, ordered result that the UI and the uploader consume.

		The unified rule
			The Roblox Animation Editor has historically saved a rig's animations in
			two different shapes:

			  1. `AnimSaves` as a **Model**  whose direct children are KeyframeSequences.
			  2. `AnimSaves` as an **ObjectValue** whose direct children are
			     KeyframeSequences, and whose `.Value` is the *name of its parent*
			     (the rig), used as a back-reference.

			Both shapes expose the sequences through the exact same call,
			`container:GetChildren()`, so the scanner deliberately does NOT branch on
			class. It only records the class so the UI can label it. The only
			class-specific handling is reading `.Value` when it exists, which is used
			purely as a label/alias and never as a lookup path.

			See Plugin/API_RESEARCH.md for the DevForum references that motivated this.

		No hardcoded paths: the scanner never assumes `Workspace.Rig.AnimSaves`.
		Rigs are discovered by searching a configurable set of service roots with a
		scan budget, and the user can always point the plugin at an explicit instance.
	]]

	local Selection = game:GetService("Selection")

	local RigScanner = {}
	RigScanner.__index = RigScanner

	--[[
		Default configuration. Every value can be overridden per-instance so the
		command-bar build and the plugin build can share the module.
	]]
	RigScanner.Defaults = {
		-- Services searched when auto-discovering rigs. Workspace first because
		-- that is where the Animation Editor puts rigs by default.
		SearchRoots = { "Workspace", "ServerStorage", "ReplicatedStorage" },

		-- Name of the container we look for (case-insensitive match).
		ContainerName = "AnimSaves",

		-- Safety valve: stop descending after this many instances so a pathological
		-- place (100k+ instances) can never freeze Studio.
		ScanBudget = 25000,

		-- How deep below `AnimSaves` we keep looking for KeyframeSequences.
		-- 1 = direct children only (the documented layout).
		-- 2+ = also look inside sub-folders/models of AnimSaves.
		MaxContainerDepth = 3,
	}

	export type RigScanResult = {
		rig: Instance?,
		rigName: string?,
		container: Instance?,
		containerClass: string?,
		containerAlias: string?,
		aliasMatchesRig: boolean,
		sequences: { KeyframeSequence },
		-- metadata rows, 1:1 with `sequences`
		entries: { RigScanner.Entry },
		truncated: boolean,
		error: string?,
	}

	export type Entry = {
		sequence: KeyframeSequence,
		name: string,
		container: Instance,
		subPath: string, -- "" when the sequence is a direct child of AnimSaves
		depth: number,
	}

	--------------------------------------------------------------------------------
	-- Construction
	--------------------------------------------------------------------------------

	function RigScanner.new(options: { [string]: any }?): RigScanner
		local self = setmetatable({}, RigScanner)
		self._options = {}
		for key, value in pairs(RigScanner.Defaults) do
			self._options[key] = value
		end
		if options then
			for key, value in pairs(options) do
				if RigScanner.Defaults[key] ~= nil or key == "SearchRoots" then
					self._options[key] = value
				end
			end
		end
		self._budgetUsed = 0
		return self
	end

	--------------------------------------------------------------------------------
	-- Container resolution
	--------------------------------------------------------------------------------

	--[[
		Returns the `AnimSaves` container for `rig`, or nil.

		Search order (first hit wins):
		  1. A direct child of `rig` whose name matches `ContainerName`.
		  2. A descendant of `rig` whose name matches `ContainerName` (bounded by
		     the scan budget) - covers rigs where AnimSaves was moved into a
		     sub-folder such as `Rig.Animation.AnimSaves`.

		The returned instance may be a Model, an ObjectValue, a Folder or anything
		else - the caller treats them all identically.
	]]
	function RigScanner:FindContainer(rig: Instance): Instance?
		if not rig then
			return nil
		end

		local wanted = self._options.ContainerName:lower()

		-- Fast path: direct child.
		for _, child in ipairs(rig:GetChildren()) do
			if child.Name:lower() == wanted then
				return child
			end
		end

		-- Slow path: bounded breadth-first descent.
		self._budgetUsed = 0
		local queue: { Instance } = rig:GetChildren()
		local depth = 0
		while depth < 4 and #queue > 0 do
			local nextQueue = {}
			for _, node in ipairs(queue) do
				self._budgetUsed += 1
				if self._budgetUsed > self._options.ScanBudget then
					return nil
				end
				if node.Name:lower() == wanted then
					return node
				end
				for _, child in ipairs(node:GetChildren()) do
					table.insert(nextQueue, child)
				end
			end
			queue = nextQueue
			depth += 1
		end

		return nil
	end

	--[[
		Reads the optional `.Value` of an ObjectValue container.

		The documented layout stores the *parent's name* there, so this returns
		the alias string plus whether it matched the rig name. When `.Value` holds
		an Instance instead (a variant seen in some places), we return the instance's
		name and flag it so the caller knows a second scan target exists.
	]]
	function RigScanner:ReadContainerAlias(container: Instance, rig: Instance?): (string?, boolean, Instance?)
		if not container or not container:IsA("ObjectValue") then
			return nil, false, nil
		end

		local ok, value = pcall(function()
			return (container :: ObjectValue).Value
		end)
		if not ok then
			return nil, false, nil
		end

		if typeof(value) == "Instance" then
			return value.Name, rig ~= nil and value.Name == rig.Name, value
		elseif type(value) == "string" then
			return value, rig ~= nil and value == rig.Name, nil
		end

		return nil, false, nil
	end

	--------------------------------------------------------------------------------
	-- Sequence collection
	--------------------------------------------------------------------------------

	--[[
		Collects every KeyframeSequence exposed by `container`.

		The unified rule: `container:GetChildren()` filtered by `IsA("KeyframeSequence")`.
		Model and ObjectValue take exactly the same path.

		If no direct KeyframeSequence children are found, and `MaxContainerDepth` > 1,
		the scanner descends into sub-containers (Folders/Models/ObjectValues) so that
		legacy layouts such as `AnimSaves/Locomotion/<sequences>` are still found. Each
		sequence is tagged with its sub-path for display.
	]]
	function RigScanner:CollectSequences(container: Instance): ({ Entry }, boolean)
		local entries: { Entry } = {}
		if not container then
			return entries, false
		end

		local maxDepth = math.max(1, math.floor(self._options.MaxContainerDepth))
		local truncated = false

		-- Pass 1 - the documented layout: direct children.
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("KeyframeSequence") then
				table.insert(entries, {
					sequence = child,
					name = child.Name,
					container = container,
					subPath = "",
					depth = 1,
				})
			end
		end

		if #entries > 0 or maxDepth <= 1 then
			return self:_sortEntries(entries), truncated
		end

		-- Pass 2 - bounded descent into sub-containers.
		local visited: { [Instance]: boolean } = { [container] = true }
		local frontier: { { container: Instance, path: string, depth: number } } = {
			{ container = container, path = "", depth = 1 },
		}

		while #frontier > 0 do
			local current = table.remove(frontier, 1)
			if current.depth >= maxDepth then
				continue
			end

			for _, child in ipairs(current.container:GetChildren()) do
				if visited[child] then
					continue
				end
				visited[child] = true
				self._budgetUsed += 1
				if self._budgetUsed > self._options.ScanBudget then
					truncated = true
					break
				end

				if child:IsA("KeyframeSequence") then
					local subPath = if current.path == "" then child.Name else current.path .. "/" .. child.Name
					table.insert(entries, {
						sequence = child,
						name = child.Name,
						container = current.container,
						subPath = subPath,
						depth = current.depth + 1,
					})
				elseif child:IsA("Folder") or child:IsA("Model") or child:IsA("ObjectValue") or child:IsA("Configuration") then
					local childPath = if current.path == "" then child.Name else current.path .. "/" .. child.Name
					table.insert(frontier, { container = child, path = childPath, depth = current.depth + 1 })
				end
			end

			if truncated then
				break
			end
		end

		return self:_sortEntries(entries), truncated
	end

	--[[
		Sorts entries by (name, subPath) so the UI, the cache and the upload order are
		all deterministic and independent of Roblox's child ordering.
	]]
	function RigScanner:_sortEntries(entries: { Entry }): { Entry }
		table.sort(entries, function(a, b)
			if a.name == b.name then
				return a.subPath < b.subPath
			end
			return a.name < b.name
		end)
		return entries
	end

	--------------------------------------------------------------------------------
	-- Public scan entry point
	--------------------------------------------------------------------------------

	--[[
		Scans a single rig and returns a structured result.

		Never throws: every failure mode is reported through `result.error` so the
		UI can render it instead of the plugin silently doing nothing.
	]]
	function RigScanner:ScanRig(rig: Instance?): RigScanResult
		local result: RigScanResult = {
			rig = rig,
			rigName = if rig then rig.Name else nil,
			container = nil,
			containerClass = nil,
			containerAlias = nil,
			aliasMatchesRig = false,
			sequences = {},
			entries = {},
			truncated = false,
			error = nil,
		}

		if not rig then
			result.error = "No rig selected."
			return result
		end
		if not rig:IsA("Instance") then
			result.error = "Selection is not an Instance."
			return result
		end

		local container = self:FindContainer(rig)
		if not container then
			result.error = string.format("No '%s' container found inside '%s'.", self._options.ContainerName, rig:GetFullName())
			return result
		end

		result.container = container
		result.containerClass = container.ClassName

		local alias, matched, aliasInstance = self:ReadContainerAlias(container, rig)
		result.containerAlias = alias
		result.aliasMatchesRig = matched

		local entries, truncated = self:CollectSequences(container)
		result.entries = entries
		result.truncated = truncated

		for _, entry in ipairs(entries) do
			table.insert(result.sequences, entry.sequence)
		end

		-- Defensive: an ObjectValue whose .Value points at another container that
		-- also holds sequences (seen in a few community rigs). Only used when the
		-- direct children yielded nothing, so the unified rule above stays primary.
		if #result.sequences == 0 and aliasInstance then
			local extra, extraTruncated = self:CollectSequences(aliasInstance)
			for _, entry in ipairs(extra) do
				entry.subPath = "(ObjectValue.Value)/" .. entry.name
				table.insert(entries, entry)
				table.insert(result.sequences, entry.sequence)
			end
			result.entries = entries
			result.truncated = result.truncated or extraTruncated
			result.containerAlias = alias .. " (ObjectValue.Value)"
		end

		if #result.sequences == 0 then
			result.error = string.format(
				"'%s' (%s) contains no KeyframeSequence children.",
				container.Name,
				container.ClassName
			)
		end

		return result
	end

	--------------------------------------------------------------------------------
	-- Rig discovery (no hardcoded paths)
	--------------------------------------------------------------------------------

	--[[
		Returns every instance under the configured service roots that owns an
		`AnimSaves` container holding at least one KeyframeSequence.

		Used to populate the UI's rig picker. Bounded by ScanBudget.
	]]
	function RigScanner:DiscoverRigs(): { Instance }
		local found: { Instance } = {}
		local seen: { [Instance]: boolean } = {}
		local wanted = self._options.ContainerName:lower()

		self._budgetUsed = 0

		for _, serviceName in ipairs(self._options.SearchRoots) do
			local ok, service = pcall(function()
				return game:GetService(serviceName)
			end)
			if ok and service then
				local queue: { Instance } = { service }
				while #queue > 0 do
					local node = table.remove(queue, 1) :: Instance
					self._budgetUsed += 1
					if self._budgetUsed > self._options.ScanBudget then
						return found
					end
					if not seen[node] then
						seen[node] = true
						if node ~= service and node.Name:lower() == wanted then
							-- Candidate container: check it actually has sequences.
							local entries = self:CollectSequences(node)
							if #entries > 0 then
								local rig = node.Parent
								if rig and not seen[rig] then
									table.insert(found, rig)
								end
							end
						end
						for _, child in ipairs(node:GetChildren()) do
							table.insert(queue, child)
						end
					end
				end
			end
		end

		-- Deterministic order for the UI.
		table.sort(found, function(a, b)
			return a:GetFullName() < b:GetFullName()
		end)

		return found
	end

	--------------------------------------------------------------------------------
	-- Studio selection helpers
	--------------------------------------------------------------------------------

	--[[
		Returns the currently selected instance, or nil. Reads game.Selection so the
		UI can react to Studio's own selection changes.
	]]
	function RigScanner:GetSelectedRig(): Instance?
		local selected = Selection:Get()
		if #selected == 0 then
			return nil
		end
		return selected[1]
	end

	--[[
		Filters a Studio selection down to instances that actually contain an
		`AnimSaves` container. Used so clicking a random Part doesn't wipe the UI.
	]]
	function RigScanner:ResolveFromSelection(): Instance?
		local selected = Selection:Get()
		for _, instance in ipairs(selected) do
			local container = self:FindContainer(instance)
			if container then
				return instance
			end
		end
		return nil
	end

	return RigScanner

end

Modules["BinaryCacheService"] = function(require)
	--[[
		BinaryCacheService.luau
		-----------------------
		Module 5 of 6 - binary serialisation + dirty-detection cache.

		Why binary at all
		-----------------
		A rig can carry hundreds of KeyframeSequences. Storing one Lua table per
		animation in Plugin settings, or one Attribute per animation, costs a lot of
		memory and a lot of JSON/XML text. Instead we pack the *metadata* of every
		animation into one compact binary blob (~60 bytes per animation) and keep a
		single copy of that blob in exactly one place.

		What gets packed, per animation
			name, two independent 32-bit hashes of the name, two independent 32-bit
			hashes of the animation's structural digest, clip length (double, so it
			round-trips exactly), keyframe count, pose count, marker count, priority,
			a flag bitfield, the last uploaded asset id and the upload timestamp.

		Where the blob lives
			Backend "Settings"    -> Plugin:SetSetting (base64url encoded)
			Backend "StringValue" -> one StringValue inside a folder in the rig

		Both backends are TEXT channels:
			* Plugin settings are persisted as JSON.
			* Instance string properties are persisted as XML.
		Neither can carry raw bytes, so the blob is base64url-encoded before it is
		written and decoded immediately after it is read (see Util.base64Encode).

		Roblox limits that are explicitly respected
			* Luau numbers are doubles: only exact up to 2^53. We therefore never
			  rely on a raw 64-bit integer; 64-bit values either use the explicitly
			  sized `I8` option (values far below 2^53) or are split into two exact
			  `I4` halves.
			* `string.pack` integral options check overflow, so all counts are stored
			  as unsigned 32-bit and clamped before packing.
			* Entry count and blob size are hard-capped, so the cache can never grow
			  without bound on a pathological rig.
			* Every read is wrapped in pcall and validated against a magic + version
			  + checksum header; a corrupt blob is discarded, never fatal.
	]]

	local Util = require("Util")

	local BinaryCacheService = {}
	BinaryCacheService.__index = BinaryCacheService

	local TWO_POW_32 = 4294967296 -- 2^32

	-- Header magic. Bumping CACHE_VERSION invalidates every previously written blob.
	local MAGIC = "ASUC" -- AnimSaves Uploader Cache
	local CACHE_VERSION = 1

	-- Per-entry flag bits.
	local FLAG_UPLOADED = 1 -- entry has a known asset id
	local FLAG_LOOP = 2 -- sequence.Loop == true
	local FLAG_VERIFIED = 4 -- asset id cross-checked against UploadedAnimations
	local FLAG_AUTO = 8 -- eligible for auto-reupload

	BinaryCacheService.FLAG_UPLOADED = FLAG_UPLOADED
	BinaryCacheService.FLAG_LOOP = FLAG_LOOP
	BinaryCacheService.FLAG_VERIFIED = FLAG_VERIFIED
	BinaryCacheService.FLAG_AUTO = FLAG_AUTO
	BinaryCacheService.MAGIC = MAGIC
	BinaryCacheService.VERSION = CACHE_VERSION

	-- Animation states reported by :Analyze().
	BinaryCacheService.STATE_NEW = "New" -- no cache entry -> must upload
	BinaryCacheService.STATE_CHANGED = "Changed" -- digest mismatch -> must re-upload
	BinaryCacheService.STATE_CLEAN = "Clean" -- digest match + asset id known -> skip
	BinaryCacheService.STATE_INCOMPLETE = "Incomplete" -- digest match, no asset id -> must upload

	--[[
		Probe whether this Luau build supports the explicitly sized `I8` integral
		option of string.pack. It does on every current Roblox client, but the probe
		costs nothing and keeps the module working if that ever changes.
	]]
	local function supportsInt64(): boolean
		local ok, result = pcall(function()
			local packed = string.pack("<I8", 1)
			if #packed ~= 8 then
				return false
			end
			return string.unpack("<I8", packed) == 1
		end)
		return ok and result == true
	end

	local INT64_SUPPORTED = supportsInt64()
	local INT_FMT = if INT64_SUPPORTED then "I8" else "I4I4"

	-- Fields that hold a 64-bit value. `savedAt` is a *header* field, but it must be
	-- listed here too: the split-64 read path keys off this table, and omitting it
	-- made string.unpack return (hi, lo, nextPos) into a single `value` binding, so
	-- `nextPos` silently became the low 32 bits of the timestamp and every
	-- following header field was read from a garbage offset.
	local WIDE_FIELDS = {
		assetId = true,
		uploadedAt = true,
		savedAt = true,
	}

	--------------------------------------------------------------------------------
	-- Pack formats: one tiny format per field.
	--------------------------------------------------------------------------------

	local ENTRY_FIELDS = {
		name = "<s2",
		nameHashA = "<I4",
		nameHashB = "<I4",
		digestA = "<I4",
		digestB = "<I4",
		length = "<d", -- double: exact round-trip for clip lengths
		keyframes = "<I4",
		poses = "<I4",
		markers = "<I4",
		priority = "<I1",
		flags = "<I1",
		assetId = "<" .. INT_FMT,
		uploadedAt = "<" .. INT_FMT,
	}

	-- Fixed serialisation order for one entry.
	local ENTRY_ORDER = {
		"name",
		"nameHashA",
		"nameHashB",
		"digestA",
		"digestB",
		"length",
		"keyframes",
		"poses",
		"markers",
		"priority",
		"flags",
		"assetId",
		"uploadedAt",
	}

	local HEADER_FIELDS = {
		magic = "<c4",
		version = "<I1",
		globalFlags = "<I1",
		entryCount = "<I4",
		rigName = "<s2",
		savedAt = "<" .. INT_FMT,
		checksum = "<I4",
	}

	local HEADER_ORDER = { "magic", "version", "globalFlags", "entryCount", "rigName", "savedAt", "checksum" }

	local function clampU32(value: number): number
		if value ~= value or value < 0 then -- NaN / negative guard
			return 0
		end
		return math.min(math.floor(value), TWO_POW_32 - 1)
	end

	local function clampU8(value: number): number
		return math.min(math.max(math.floor(value), 0), 255)
	end

	--[[
		Packs a 64-bit value in the layout :Deserialize() reads back.

		With I8 support this is one option. Without it the value is split into two
		exact unsigned 32-bit halves. The split is only lossless while the value
		stays below 2^53, which is the exact-integer range of a Luau double and is
		the module-wide hard limit on every 64-bit value it stores (see the header
		comment). Both halves are < 2^32 by construction, so they always fit I4.

		The reader's counterpart is `hi * TWO_POW_32 + lo`.
	]]
	local function packWide(value: number): string
		if INT64_SUPPORTED then
			return string.pack("<I8", value)
		end
		local hi = math.floor(value / TWO_POW_32)
		local lo = value - hi * TWO_POW_32
		return string.pack("<I4I4", clampU32(hi), clampU32(lo))
	end

	--------------------------------------------------------------------------------
	-- Digest accumulator
	-- Streams bytes into two independent hashes, so a multi-megabyte animation never
	-- needs a large temporary buffer.
	--------------------------------------------------------------------------------

	local Digest = {}
	Digest.__index = Digest

	function Digest.new()
		return setmetatable({ a = 0x811C9DC5, b = 5381 }, Digest)
	end

	function Digest:bytes(chunk: string)
		if #chunk == 0 then
			return
		end
		self.a = Util.fnv1a32(chunk, self.a)
		self.b = Util.djb2(chunk, self.b)
	end

	function Digest:number(value: number)
		self:bytes(string.pack("<d", value))
	end

	function Digest:text(value: string)
		self:number(#value)
		self:bytes(value)
	end

	--------------------------------------------------------------------------------
	-- Types
	--------------------------------------------------------------------------------

	export type CacheEntry = {
		name: string,
		nameHashA: number,
		nameHashB: number,
		digestA: number,
		digestB: number,
		length: number,
		keyframes: number,
		poses: number,
		markers: number,
		priority: number,
		flags: number,
		assetId: number,
		uploadedAt: number,
	}

	export type AnalysisRecord = {
		sequence: KeyframeSequence,
		name: string,
		subPath: string,
		depth: number,
		state: string,
		dirty: boolean,
		cached: boolean,
		digestA: number,
		digestB: number,
		nameHashA: number,
		nameHashB: number,
		length: number,
		keyframes: number,
		poses: number,
		markers: number,
		priority: number,
		flags: number,
		cachedAssetId: number,
		cachedUploadedAt: number,
		selected: boolean,
	}

	--------------------------------------------------------------------------------
	-- Construction
	--------------------------------------------------------------------------------

	function BinaryCacheService.new(options: { [string]: any }?): BinaryCacheService
		local self = setmetatable({}, BinaryCacheService)

		self._options = {
			-- "Settings" or "StringValue"
			Backend = "Settings",
			-- "Deep" walks every keyframe/pose; "Fast" only hashes cheap metadata.
			HashMode = "Deep",
			-- StringValue backend layout.
			CacheFolderName = "_AnimUploaderCache",
			CacheValueName = "BinaryCache",
			-- Hard caps. 10k animations * ~60 B ~= 600 KB.
			MaxEntries = 10000,
			MaxBlobBytes = 1048576,
			-- Yield every N poses while hashing so Studio never stalls.
			YieldEvery = 4000,
		}
		if options then
			for key, value in pairs(options) do
				self._options[key] = value
			end
		end

		self._plugin = nil -- Plugin?
		self._rigInstance = nil -- Instance?
		self._entries = {} -- { [string]: CacheEntry }
		self._order = {} -- { string }
		self._blob = ""
		self._rigName = nil -- string?
		self._savedAt = 0
		self._globalFlags = 0
		self._dirty = false
		self._loaded = false
		self._lastError = nil -- string?
		self._stats = { entries = 0, blobBytes = 0, encodedBytes = 0 }

		return self
	end

	function BinaryCacheService:SetPlugin(pluginInstance: Plugin?)
		self._plugin = pluginInstance
		return self
	end

	function BinaryCacheService:SetRigInstance(rig: Instance?)
		self._rigInstance = rig
		if rig then
			self._rigName = rig.Name
		end
		return self
	end

	function BinaryCacheService:GetLastError(): string?
		return self._lastError
	end

	function BinaryCacheService:IsDirty(): boolean
		return self._dirty
	end

	function BinaryCacheService:Count(): number
		local n = 0
		for _ in pairs(self._entries) do
			n += 1
		end
		return n
	end

	function BinaryCacheService:GetStats()
		self._stats.entries = self:Count()
		self._stats.blobBytes = #self._blob
		return self._stats
	end

	--------------------------------------------------------------------------------
	-- Digest computation
	--------------------------------------------------------------------------------

	--[[
		Computes the structural digest of a KeyframeSequence.

		Deep mode feeds, in a deterministic order:
			sequence name, Loop, Priority, keyframe count
			for each keyframe (sorted by Time then Name):
				Time, Name, marker count, each marker's name and value
				for each pose in pre-order:
					Name, Weight, EasingStyle, EasingDirection, all 12 CFrame components

		Fast mode only hashes cheap metadata (name, Loop, Priority, keyframe count,
		length). It is roughly an order of magnitude faster and is the right choice
		for 1000+ animation libraries where a full re-hash would be noticeable.

		Returns digestA, digestB, meta.
	]]
	function BinaryCacheService:ComputeDigest(sequence: KeyframeSequence, yieldHook: (() -> ())?)
		local digest = Digest.new()
		local meta = { length = 0, keyframes = 0, poses = 0, markers = 0, priority = 0 }

		digest:text(sequence.Name)

		local loopOk, loop = pcall(function()
			return sequence.Loop
		end)
		digest:number(if loopOk then (if loop then 1 else 0) else 0)

		local prioOk, priority = pcall(function()
			return sequence.Priority
		end)
		local priorityValue = 0
		if prioOk and typeof(priority) == "EnumItem" then
			priorityValue = priority.Value
		end
		meta.priority = priorityValue
		digest:number(priorityValue)

		local keyframes: { Keyframe } = {}
		local kfOk = pcall(function()
			return sequence:GetKeyframes()
		end)
		if kfOk then
			keyframes = sequence:GetKeyframes()
		end
		meta.keyframes = #keyframes
		digest:number(#keyframes)

		-- Deterministic keyframe order.
		local sortedKeyframes = table.clone(keyframes)
		table.sort(sortedKeyframes, function(a, b)
			if a.Time == b.Time then
				return a.Name < b.Name
			end
			return a.Time < b.Time
		end)

		if self._options.HashMode == "Fast" then
			for _, keyframe in ipairs(sortedKeyframes) do
				if keyframe.Time > meta.length then
					meta.length = keyframe.Time
				end
			end
			digest:number(meta.length)
			return digest.a, digest.b, meta
		end

		local yieldCounter = 0
		local yieldEvery = math.max(1, math.floor(self._options.YieldEvery))

		local function hashPose(pose: Pose)
			meta.poses += 1
			digest:text(pose.Name)
			digest:number(pose.Weight)

			local styleOk, style = pcall(function()
				return pose.EasingStyle
			end)
			digest:number(if styleOk and typeof(style) == "EnumItem" then style.Value else -1)

			local dirOk, direction = pcall(function()
				return pose.EasingDirection
			end)
			digest:number(if dirOk and typeof(direction) == "EnumItem" then direction.Value else -1)

			-- All 12 CFrame components packed in one call instead of twelve.
			local cfOk, components = pcall(function()
				return { pose.CFrame:GetComponents() }
			end)
			if cfOk and #components == 12 then
				digest:bytes(string.pack("<dddddddddddd", table.unpack(components, 1, 12)))
			else
				digest:number(0)
			end

			yieldCounter += 1
			if yieldHook and yieldCounter % yieldEvery == 0 then
				yieldHook()
			end

			local subOk, subPoses = pcall(function()
				return pose:GetSubPoses()
			end)
			if subOk then
				local sorted = table.clone(subPoses)
				table.sort(sorted, function(a, b)
					return a.Name < b.Name
				end)
				for _, sub in ipairs(sorted) do
					if sub:IsA("Pose") then
						hashPose(sub)
					end
				end
			end
		end

		for _, keyframe in ipairs(sortedKeyframes) do
			if keyframe.Time > meta.length then
				meta.length = keyframe.Time
			end
			digest:number(keyframe.Time)
			digest:text(keyframe.Name)

			local markers: { KeyframeMarker } = {}
			local mkOk = pcall(function()
				return keyframe:GetMarkers()
			end)
			if mkOk then
				markers = keyframe:GetMarkers()
			end
			meta.markers += #markers
			digest:number(#markers)
			table.sort(markers, function(a, b)
				return a.Name < b.Name
			end)
			for _, marker in ipairs(markers) do
				digest:text(marker.Name)
				digest:number(marker.Value)
			end

			local poses: { Pose } = {}
			local pOk = pcall(function()
				return keyframe:GetPoses()
			end)
			if pOk then
				poses = keyframe:GetPoses()
			end
			digest:number(#poses)

			local sortedPoses = table.clone(poses)
			table.sort(sortedPoses, function(a, b)
				return a.Name < b.Name
			end)
			for _, pose in ipairs(sortedPoses) do
				if pose:IsA("Pose") then
					hashPose(pose)
				end
			end

			if yieldHook then
				yieldHook()
			end
		end

		return digest.a, digest.b, meta
	end

	--------------------------------------------------------------------------------
	-- Serialisation
	--------------------------------------------------------------------------------

	local function serializeEntry(entry: CacheEntry): string
		local parts = table.create(#ENTRY_ORDER)
		for _, field in ipairs(ENTRY_ORDER) do
			-- Wide fields go through packWide so the I8 and I4I4 layouts stay in
			-- sync with what deserializeEntry expects.
			if WIDE_FIELDS[field] then
				parts[#parts + 1] = packWide(entry[field])
			else
				parts[#parts + 1] = string.pack(ENTRY_FIELDS[field], entry[field])
			end
		end
		return table.concat(parts)
	end

	--[[
		Reads one entry out of `blob` starting at `pos`.
		Returns entry, nextPosition. Returns nil, nil when the blob is truncated.
	]]
	local function deserializeEntry(blob: string, pos: number): (CacheEntry?, number?)
		local cursor = pos
		local values: { [string]: any } = {}

		for _, field in ipairs(ENTRY_ORDER) do
			local fmt = ENTRY_FIELDS[field]

			if WIDE_FIELDS[field] and not INT64_SUPPORTED then
				-- Split-64 layout: (hi, lo, nextPos)
				local ok, hi, lo, nextPos = pcall(string.unpack, fmt, blob, cursor)
				if not ok or type(nextPos) ~= "number" then
					return nil, nil
				end
				values[field] = hi * TWO_POW_32 + lo
				cursor = nextPos
			else
				local ok, value, nextPos = pcall(string.unpack, fmt, blob, cursor)
				if not ok or type(nextPos) ~= "number" then
					return nil, nil
				end
				values[field] = value
				cursor = nextPos
			end
		end

		local entry: CacheEntry = {
			name = values.name,
			nameHashA = values.nameHashA,
			nameHashB = values.nameHashB,
			digestA = values.digestA,
			digestB = values.digestB,
			length = values.length,
			keyframes = values.keyframes,
			poses = values.poses,
			markers = values.markers,
			priority = values.priority,
			flags = values.flags,
			assetId = values.assetId,
			uploadedAt = values.uploadedAt,
		}
		return entry, cursor
	end

	--[[
		Serialises the whole cache into a single binary string.
	]]
	function BinaryCacheService:Serialize(): string
		-- Rebuild a stable, de-duplicated order list.
		local seen: { [string]: boolean } = {}
		local names: { string } = {}
		for _, name in ipairs(self._order) do
			if self._entries[name] and not seen[name] then
				seen[name] = true
				table.insert(names, name)
			end
		end
		for name in pairs(self._entries) do
			if not seen[name] then
				seen[name] = true
				table.insert(names, name)
			end
		end

		local body = table.create(#names)
		for _, name in ipairs(names) do
			body[#body + 1] = serializeEntry(self._entries[name])
		end
		local bodyBlob = table.concat(body)

		local headerParts = table.create(#HEADER_ORDER)
		for _, field in ipairs(HEADER_ORDER) do
			local value
			if field == "magic" then
				value = MAGIC
			elseif field == "version" then
				value = CACHE_VERSION
			elseif field == "globalFlags" then
				value = clampU8(self._globalFlags)
			elseif field == "entryCount" then
				value = clampU32(#names)
			elseif field == "rigName" then
				value = self._rigName or ""
			elseif field == "checksum" then
				value = clampU32(Util.fnv1a32(bodyBlob))
			end
			if field == "savedAt" then
				-- Same wide-field treatment as the entry body.
				headerParts[#headerParts + 1] = packWide(math.floor(self._savedAt))
			else
				headerParts[#headerParts + 1] = string.pack(HEADER_FIELDS[field], value)
			end
		end

		self._order = names
		return table.concat(headerParts) .. bodyBlob
	end

	--[[
		Parses a blob produced by :Serialize(). Returns true on success.
		A malformed blob is reported through GetLastError() and leaves the cache empty.
	]]
	function BinaryCacheService:Deserialize(blob: string): boolean
		self._lastError = nil
		self._entries = {}
		self._order = {}

		if type(blob) ~= "string" or #blob < 16 then
			self._lastError = "Cache blob is empty or too small."
			return false
		end

		local ok, err = pcall(function()
			local cursor = 1
			local values: { [string]: any } = {}

			for _, field in ipairs(HEADER_ORDER) do
				local fmt = HEADER_FIELDS[field]
				if WIDE_FIELDS[field] and not INT64_SUPPORTED then
					local unpackOk, hi, lo, nextPos = pcall(string.unpack, fmt, blob, cursor)
					if not unpackOk or type(nextPos) ~= "number" then
						error("truncated header field " .. field, 0)
					end
					values[field] = hi * TWO_POW_32 + lo
					cursor = nextPos
				else
					local unpackOk, value, nextPos = pcall(string.unpack, fmt, blob, cursor)
					if not unpackOk or type(nextPos) ~= "number" then
						error("truncated header field " .. field, 0)
					end
					values[field] = value
					cursor = nextPos
				end
			end

			if values.magic ~= MAGIC then
				error("bad magic", 0)
			end
			if values.version ~= CACHE_VERSION then
				error("unsupported cache version " .. tostring(values.version), 0)
			end

			local body = blob:sub(cursor)
			if Util.fnv1a32(body) ~= values.checksum then
				error("checksum mismatch", 0)
			end

			self._rigName = values.rigName
			self._savedAt = values.savedAt
			self._globalFlags = values.globalFlags

			local readPos = 1
			local limit = math.min(values.entryCount, self._options.MaxEntries)
			for _ = 1, limit do
				local entry, nextPos = deserializeEntry(body, readPos)
				if not entry then
					break
				end
				if not self._entries[entry.name] then
					table.insert(self._order, entry.name)
				end
				self._entries[entry.name] = entry
				readPos = nextPos
			end
		end)

		if not ok then
			self._lastError = tostring(err)
			self._entries = {}
			self._order = {}
			return false
		end

		self._loaded = true
		return true
	end

	--------------------------------------------------------------------------------
	-- Persistence
	--------------------------------------------------------------------------------

	--[[
		Builds a Plugin-settings key that is guaranteed JSON-safe.

		Plugin settings are stored as a JSON object and the docs explicitly warn that
		periods, quotes, backslashes and newlines in KEYS can corrupt the settings
		file. A rig's full name contains periods and dots, so it never goes into the
		key verbatim: it is sanitised and then fingerprinted with two hashes.
	]]
	local function buildSettingsKey(rigName: string): string
		local sanitized = (rigName:gsub("[^%w_]", "_")):sub(1, 48)
		local hashA, hashB = Util.hash64(rigName)
		return string.format("AnimSavesCache_v%d_%s_%d_%d", CACHE_VERSION, sanitized, hashA, hashB)
	end

	BinaryCacheService.BuildSettingsKey = buildSettingsKey

	--[[
		Finds (never creates) the StringValue used by the "StringValue" backend.
	]]
	function BinaryCacheService:FindCacheValue(rig: Instance?): StringValue?
		if not rig then
			return nil
		end
		local folder = rig:FindFirstChild(self._options.CacheFolderName)
		if not folder or not folder:IsA("Folder") then
			return nil
		end
		local value = folder:FindFirstChild(self._options.CacheValueName)
		if not value or not value:IsA("StringValue") then
			return nil
		end
		return value :: StringValue
	end

	--[[
		Finds or creates the StringValue used by the "StringValue" backend.
	]]
	function BinaryCacheService:GetCacheValue(rig: Instance?): StringValue?
		if not rig then
			return nil
		end
		local existing = self:FindCacheValue(rig)
		if existing then
			return existing
		end

		local folder = rig:FindFirstChild(self._options.CacheFolderName)
		if not folder or not folder:IsA("Folder") then
			if folder then
				folder:Destroy()
			end
			folder = Instance.new("Folder")
			folder.Name = self._options.CacheFolderName
			folder.Parent = rig
		end

		local value = Instance.new("StringValue")
		value.Name = self._options.CacheValueName
		value.Parent = folder
		return value
	end

	--[[
		Loads the cache for `rig` using the configured backend.
		Returns true when a valid blob was found and parsed. A missing blob is not an
		error - it just means this rig has never been uploaded from here.
	]]
	function BinaryCacheService:Load(rig: Instance?): boolean
		self._entries = {}
		self._order = {}
		self._loaded = false
		self._lastError = nil

		if not rig then
			self._lastError = "No rig to load a cache for."
			return false
		end

		self._rigName = rig.Name
		self._rigInstance = rig

		local encoded: any = nil

		if self._options.Backend == "StringValue" then
			local value = self:FindCacheValue(rig)
			encoded = if value then value.Value else nil
		else
			if not self._plugin then
				self._lastError = "Settings backend requires a Plugin reference."
				return false
			end
			local ok, stored = pcall(function()
				return (self._plugin :: Plugin):GetSetting(buildSettingsKey(rig.Name))
			end)
			encoded = if ok then stored else nil
		end

		if type(encoded) ~= "string" or #encoded == 0 then
			self._savedAt = 0
			return false
		end

		local decoded: string? = nil
		local ok, err = pcall(function()
			decoded = Util.base64Decode(encoded)
		end)
		if not ok or not decoded then
			-- Fall back to hex in case an older build wrote that format.
			ok, err = pcall(function()
				decoded = Util.hexDecode(encoded)
			end)
			if not ok or not decoded then
				self._lastError = "Cache blob could not be decoded: " .. tostring(err)
				return false
			end
		end

		return self:Deserialize(decoded)
	end

	--[[
		Persists the cache. Returns true on success.
	]]
	function BinaryCacheService:Save(): boolean
		self._savedAt = os.time()
		local blob = self:Serialize()

		if #blob > self._options.MaxBlobBytes then
			self._lastError = string.format(
				"Cache blob is %d bytes, over the %d byte limit - dropping oldest entries.",
				#blob,
				self._options.MaxBlobBytes
			)
			self:PruneOldest(math.ceil(self:Count() * 0.25))
			blob = self:Serialize()
			if #blob > self._options.MaxBlobBytes then
				return false
			end
		end

		local encoded = Util.base64Encode(blob)
		self._blob = blob
		self._stats.blobBytes = #blob
		self._stats.encodedBytes = #encoded
		self._dirty = false

		if self._options.Backend == "StringValue" then
			if not self._rigInstance then
				self._lastError = "StringValue backend needs the rig instance."
				return false
			end
			local value = self:GetCacheValue(self._rigInstance)
			if not value then
				return false
			end
			value.Value = encoded
			return true
		end

		if not self._plugin then
			self._lastError = "Settings backend requires a Plugin reference."
			return false
		end

		local key = buildSettingsKey(self._rigName or "unknown")
		local ok, err = pcall(function()
			(self._plugin :: Plugin):SetSetting(key, encoded)
		end)
		if not ok then
			self._lastError = "SetSetting failed: " .. tostring(err)
			return false
		end

		-- The docs warn SetSetting can silently fail when several Studio windows
		-- share the settings file, so verify the write.
		local verifyOk, stored = pcall(function()
			return (self._plugin :: Plugin):GetSetting(key)
		end)
		if not verifyOk or stored ~= encoded then
			self._lastError = "SetSetting did not persist (another Studio window may be writing)."
			return false
		end

		return true
	end

	--------------------------------------------------------------------------------
	-- Dirty detection
	--------------------------------------------------------------------------------

	--[[
		Analyses a RigScanner result against the loaded cache.

		For every sequence we compute the structural digest, look for a cache entry
		with the same name, and classify:

			New        - no cache entry                         -> dirty
			Changed    - digest mismatch                        -> dirty
			Clean      - digest match and FLAG_UPLOADED set     -> not dirty
			Incomplete - digest match but no asset id recorded  -> dirty

		Returns an array of AnalysisRecord in the same order as the scanner's entries
		so UI rows stay aligned.
	]]
	function BinaryCacheService:Analyze(scanResult: any, yieldHook: (() -> ())?): { AnalysisRecord }
		local records: { AnalysisRecord } = {}

		for _, entry in ipairs(scanResult.entries or {}) do
			local sequence = entry.sequence
			local nameA, nameB = Util.hash64(sequence.Name)
			local digestA, digestB, meta = self:ComputeDigest(sequence, yieldHook)

			local cached: CacheEntry? = self._entries[sequence.Name]
			local state: string
			local dirty: boolean

			if not cached then
				state = BinaryCacheService.STATE_NEW
				dirty = true
			elseif cached.digestA ~= digestA or cached.digestB ~= digestB or cached.nameHashA ~= nameA or cached.nameHashB ~= nameB then
				state = BinaryCacheService.STATE_CHANGED
				dirty = true
			elseif bit32.band(cached.flags, FLAG_UPLOADED) ~= 0 and cached.assetId > 0 then
				state = BinaryCacheService.STATE_CLEAN
				dirty = false
			else
				state = BinaryCacheService.STATE_INCOMPLETE
				dirty = true
			end

			table.insert(records, {
				sequence = sequence,
				name = sequence.Name,
				subPath = entry.subPath or "",
				depth = entry.depth or 1,
				state = state,
				dirty = dirty,
				cached = cached ~= nil,
				digestA = digestA,
				digestB = digestB,
				nameHashA = nameA,
				nameHashB = nameB,
				length = meta.length,
				keyframes = meta.keyframes,
				poses = meta.poses,
				markers = meta.markers,
				priority = meta.priority,
				flags = if cached then cached.flags else 0,
				cachedAssetId = if cached then cached.assetId else 0,
				cachedUploadedAt = if cached then cached.uploadedAt else 0,
				selected = dirty,
			})
		end

		return records
	end

	--[[
		Records a successful upload and marks the entry clean.
	]]
	function BinaryCacheService:MarkUploaded(record: AnalysisRecord, assetId: number)
		local flags = bit32.bor(record.flags, FLAG_UPLOADED)

		local loopOk, loop = pcall(function()
			return record.sequence.Loop
		end)
		if loopOk and loop then
			flags = bit32.bor(flags, FLAG_LOOP)
		end

		local entry: CacheEntry = {
			name = record.name,
			nameHashA = record.nameHashA,
			nameHashB = record.nameHashB,
			digestA = record.digestA,
			digestB = record.digestB,
			length = record.length,
			keyframes = record.keyframes,
			poses = record.poses,
			markers = record.markers,
			priority = record.priority,
			flags = flags,
			assetId = math.floor(assetId),
			uploadedAt = os.time(),
		}

		if not self._entries[record.name] then
			table.insert(self._order, record.name)
		end
		self._entries[record.name] = entry

		self:EnforceLimits()
		self._dirty = true
	end

	--[[
		Forces an entry back to the dirty state without deleting it, so the UI shows
		"Changed" and the uploader will not skip it.
	]]
	function BinaryCacheService:MarkDirty(name: string)
		local entry = self._entries[name]
		if not entry then
			return
		end
		entry.flags = bit32.band(entry.flags, bit32.bnot(FLAG_UPLOADED))
		entry.assetId = 0
		self._dirty = true
	end

	--[[
		Drops cache entries that no longer exist in the rig, so the blob does not grow
		forever as animations are renamed or deleted. Returns the number removed.
	]]
	function BinaryCacheService:PruneOrphans(scanResult: any): number
		local live: { [string]: boolean } = {}
		for _, entry in ipairs(scanResult.entries or {}) do
			live[entry.name] = true
		end

		local removed = 0
		for name in pairs(self._entries) do
			if not live[name] then
				self._entries[name] = nil
				removed += 1
			end
		end

		if removed > 0 then
			local cleaned: { string } = {}
			for _, name in ipairs(self._order) do
				if self._entries[name] then
					table.insert(cleaned, name)
				end
			end
			self._order = cleaned
			self._dirty = true
		end

		return removed
	end

	--[[
		Drops the oldest N entries (by upload timestamp). Returns the number removed.
	]]
	function BinaryCacheService:PruneOldest(count: number): number
		if count <= 0 or self:Count() == 0 then
			return 0
		end

		local list = table.clone(self._order)
		table.sort(list, function(a, b)
			return (self._entries[a].uploadedAt or 0) < (self._entries[b].uploadedAt or 0)
		end)

		local removed = 0
		for i = 1, math.min(count, #list) do
			if self._entries[list[i]] then
				self._entries[list[i]] = nil
				removed += 1
			end
		end

		if removed > 0 then
			local cleaned: { string } = {}
			for _, name in ipairs(self._order) do
				if self._entries[name] then
					table.insert(cleaned, name)
				end
			end
			self._order = cleaned
			self._dirty = true
		end

		return removed
	end

	function BinaryCacheService:EnforceLimits()
		local guard = 0
		while self:Count() > self._options.MaxEntries and guard < 100 do
			if self:PruneOldest(math.ceil(self._options.MaxEntries * 0.1)) == 0 then
				break
			end
			guard += 1
		end
	end

	function BinaryCacheService:GetEntry(name: string): CacheEntry?
		return self._entries[name]
	end

	function BinaryCacheService:GetEntries(): { CacheEntry }
		local out = {}
		for _, name in ipairs(self._order) do
			if self._entries[name] then
				table.insert(out, self._entries[name])
			end
		end
		return out
	end

	--[[
		Wipes the in-memory cache and the persisted blob.
	]]
	function BinaryCacheService:Reset(rig: Instance?)
		if rig then
			self._rigName = rig.Name
			self._rigInstance = rig
		end

		self._entries = {}
		self._order = {}
		self._blob = ""
		self._savedAt = 0
		self._dirty = false
		self._lastError = nil

		if self._options.Backend == "StringValue" then
			local value = self:GetCacheValue(self._rigInstance)
			if value then
				value.Value = ""
			end
		elseif self._plugin then
			pcall(function()
				(self._plugin :: Plugin):SetSetting(buildSettingsKey(self._rigName or "unknown"), "")
			end)
		end
	end

	--[[
		Human-readable summary used by the UI and the log.
	]]
	function BinaryCacheService:Describe(): string
		return string.format(
			"%s backend | %s hash | %d entries | %s blob (%s encoded) | v%d%s",
			self._options.Backend,
			self._options.HashMode,
			self:Count(),
			Util.formatBytes(#self._blob),
			Util.formatBytes(#Util.base64Encode(self._blob)),
			CACHE_VERSION,
			if self._dirty then " | UNSAVED" else ""
		)
	end

	return BinaryCacheService

end

Modules["UploadService"] = function(require)
	--[[
		UploadService.luau
		------------------
		Module 2 of 6 - the AssetService upload module.

		Upload path (the ONLY one this plugin uses)
		-------------------------------------------
			game:GetService("AssetService")
			AssetService:CreateAssetAsync(keyframeSequence, Enum.AssetType.Animation, params)

		`CreateAssetAsync` is a yielding method that returns a tuple:

			(Enum.CreateAssetResult, number | string)

		* On success the first value is `Enum.CreateAssetResult.Success` and the second
		  is the new asset id (a number).
		* On failure the first value is one of PermissionDenied / UploadFailed /
		  Unknown and the second is a human-readable diagnostic string.
		* If the call itself cannot be made (for example the "CreateAssetAsync Luau
		  API" beta feature is not enabled in Studio) it raises a Lua error, which we
		  catch with pcall.

		ClipEditor is never touched. No rig selection dialog, no Animation Editor UI,
		no "three dots -> publish". The only thing the user ever sees is Roblox's own
		permission popup for the asset-creation capability.

		Documented constraints that are honoured here
			* The API is rate limited to roughly 30 requests per minute, so uploads are
			  throttled (default 20/min) and run in a coroutine so Studio stays live.
			* The API only works from a LOCAL plugin, not from Creator Store plugins.
			  `:IsAvailable()` surfaces this up front.
			* `Enum.AssetCreatorType` / `CreatorId` must be supplied for group uploads.
			* Deprecated/removed members such as AssetService:PromptCreateAssetAsync,
			  PromptPublishAssetAsync and CreatePlaceAsync are never called.

		See Plugin/API_RESEARCH.md for the source links.
	]]

	local AssetService = game:GetService("AssetService")

	--[[
		"Clean" state string. Duplicated here (rather than required from
		BinaryCacheService) so the two modules stay independent and there is no
		circular dependency. Both modules must agree on this value.
	]]
	local STATE_CLEAN = "Clean"

	local UploadService = {}
	UploadService.__index = UploadService

	--[[
		Defaults. Overridable per instance (the UI writes into these).
	]]
	UploadService.Defaults = {
		-- The API is documented as limited to 30 requests/minute. Stay under it.
		RequestsPerMinute = 20,

		-- Transient failures (UploadFailed / Unknown / raised errors) are retried.
		MaxRetries = 2,
		RetryDelaySeconds = 5,

		-- "Direct"  : pass the rig's own KeyframeSequence (what community bulk
		--             uploaders do, and the cheapest option).
		-- "Clone"   : upload an unparented clone, which guarantees the object passed
		--             to the API is a standalone root. Slightly slower/safer.
		UploadMode = "Direct",

		-- Asset metadata.
		DescriptionTemplate = "Uploaded with the AnimSaves Bulk Uploader Studio plugin.",
		CreatorType = Enum.AssetCreatorType.User,
		GroupId = nil :: number?,

		-- Optional name decoration. The uploaded asset name defaults to the
		-- KeyframeSequence's own name.
		NamePrefix = "",
		NameSuffix = "",

		-- Yield between uploads so the Studio UI keeps painting.
		InterItemDelay = 0.05,
	}

	export type UploadOutcome = {
		success: boolean,
		assetId: number,
		resultEnum: string,
		message: string,
		attempts: number,
		elapsed: number,
		sequence: KeyframeSequence?,
		name: string?,
	}

	--------------------------------------------------------------------------------
	-- Construction
	--------------------------------------------------------------------------------

	function UploadService.new(options: { [string]: any }?): UploadService
		local self = setmetatable({}, UploadService)

		self._options = {}
		for key, value in pairs(UploadService.Defaults) do
			self._options[key] = value
		end
		if options then
			for key, value in pairs(options) do
				self._options[key] = value
			end
		end

		self._requestTimes = {} -- { number }
		self._cancelled = false
		self._busy = false
		self._lastError = nil -- string?
		self._log = {}

		return self
	end

	function UploadService:SetOptions(options: { [string]: any })
		for key, value in pairs(options or {}) do
			self._options[key] = value
		end
		return self
	end

	function UploadService:GetOptions(): { [string]: any }
		return self._options
	end

	function UploadService:IsBusy(): boolean
		return self._busy
	end

	function UploadService:GetLastError(): string?
		return self._lastError
	end

	function UploadService:Cancel()
		self._cancelled = true
		return self
	end

	function UploadService:IsCancelled(): boolean
		return self._cancelled
	end

	function UploadService:Log(level: string, message: string)
		table.insert(self._log, { level = level, message = message, time = os.clock() })
		if #self._log > 500 then
			table.remove(self._log, 1)
		end
		if level == "error" then
			warn("[AnimSavesUploader] " .. message)
		elseif level == "warn" then
			warn("[AnimSavesUploader] " .. message)
		else
			print("[AnimSavesUploader] " .. message)
		end
	end

	function UploadService:GetLog(): { { level: string, message: string } }
		return self._log
	end

	--------------------------------------------------------------------------------
	-- Availability check
	--------------------------------------------------------------------------------

	--[[
		Verifies the upload path is usable before we burn the user's time.

		Returns (available: boolean, reason: string?)

		Two things are checked:
		  1. AssetService exists and exposes CreateAssetAsync (always true on a
		     current client, but cheap to confirm).
		  2. Enum.AssetType.Animation and Enum.CreateAssetResult are present, because
		     those are what we branch on.
	]]
	function UploadService:IsAvailable(): (boolean, string?)
		if typeof(AssetService) ~= "Instance" or not AssetService:IsA("AssetService") then
			return false, "AssetService could not be acquired."
		end

		if type(AssetService.CreateAssetAsync) ~= "function" then
			return false, "AssetService:CreateAssetAsync is missing. Update Roblox Studio."
		end

		if not Enum.AssetType or not Enum.AssetType.Animation then
			return false, "Enum.AssetType.Animation is missing."
		end

		if not Enum.CreateAssetResult or not Enum.CreateAssetResult.Success then
			return false, "Enum.CreateAssetResult is missing."
		end

		return true, nil
	end

	--[[
		Translates a CreateAssetResult enum item into a stable string key so the UI
		and the log never depend on enum naming.
	]]
	local function resultKey(resultEnum: any): string
		if typeof(resultEnum) == "EnumItem" then
			return resultEnum.Name
		end
		return tostring(resultEnum)
	end

	--[[
		Detects the specific error raised when the "CreateAssetAsync Luau API" beta
		feature is not enabled in Studio, so we can give an actionable message.
	]]
	local function isBetaFeatureError(message: string): boolean
		if type(message) ~= "string" then
			return false
		end
		local lower = message:lower()
		return lower:find("not available yet", 1, true) ~= nil
			or lower:find("unable to create asset", 1, true) ~= nil
			or lower:find("createassetasync", 1, true) ~= nil and lower:find("beta", 1, true) ~= nil
	end

	--------------------------------------------------------------------------------
	-- Request parameters
	--------------------------------------------------------------------------------

	--[[
		Builds the `requestParameters` dictionary for CreateAssetAsync.

		Only documented keys are used: Name, Description, CreatorId, CreatorType.
		`IsPackage` is intentionally omitted - it only applies to Enum.AssetType.Model.
	]]
	function UploadService:BuildParams(sequence: KeyframeSequence, overrides: { [string]: any }?): { [string]: any }
		local options = self._options
		local name = sequence.Name

		if overrides and overrides.name then
			name = overrides.name
		else
			name = options.NamePrefix .. sequence.Name .. options.NameSuffix
		end

		local description = options.DescriptionTemplate
		if overrides and overrides.description then
			description = overrides.description
		end

		local params: { [string]: any } = {
			Name = name,
			Description = description,
		}

		local creatorType = options.CreatorType
		if overrides and overrides.creatorType then
			creatorType = overrides.creatorType
		end
		params.CreatorType = creatorType

		local groupId = options.GroupId
		if overrides and overrides.groupId ~= nil then
			groupId = overrides.groupId
		end

		if creatorType == Enum.AssetCreatorType.Group then
			if type(groupId) ~= "number" then
				error("CreatorType is Group but no valid GroupId was provided.", 2)
			end
			params.CreatorId = math.floor(groupId)
		end

		return params
	end

	--------------------------------------------------------------------------------
	-- Rate limiting
	--------------------------------------------------------------------------------

	--[[
		Blocks until a request slot is free, respecting `RequestsPerMinute`.

		Waits are chunked (max 1s at a time) so :Cancel() stays responsive.
	]]
	function UploadService:WaitForSlot()
		local rpm = math.clamp(math.floor(self._options.RequestsPerMinute), 1, 30)
		local now = time()

		-- Drop timestamps outside the rolling 60s window.
		local kept: { number } = {}
		for _, stamp in ipairs(self._requestTimes) do
			if now - stamp < 60 then
				table.insert(kept, stamp)
			end
		end
		self._requestTimes = kept

		while #self._requestTimes >= rpm do
			if self._cancelled then
				return
			end
			local oldest = self._requestTimes[1]
			local waitFor = 60 - (now - oldest)
			if waitFor <= 0 then
				table.remove(self._requestTimes, 1)
			else
				task.wait(math.min(waitFor, 1))
				now = time()
				kept = {}
				for _, stamp in ipairs(self._requestTimes) do
					if now - stamp < 60 then
						table.insert(kept, stamp)
					end
				end
				self._requestTimes = kept
			end
		end

		table.insert(self._requestTimes, time())
	end

	--------------------------------------------------------------------------------
	-- Single upload
	--------------------------------------------------------------------------------

	--[[
		Uploads one KeyframeSequence with AssetService:CreateAssetAsync.

		Returns an UploadOutcome. Never throws.
	]]
	function UploadService:UploadOne(sequence: KeyframeSequence, overrides: { [string]: any }?): UploadOutcome
		local outcome: UploadOutcome = {
			success = false,
			assetId = 0,
			resultEnum = "Unknown",
			message = "",
			attempts = 0,
			elapsed = 0,
			sequence = sequence,
			name = if sequence then sequence.Name else nil,
		}

		if not sequence or not sequence:IsA("KeyframeSequence") then
			outcome.resultEnum = "InvalidInput"
			outcome.message = "Target is not a KeyframeSequence."
			return outcome
		end

		if self._cancelled then
			outcome.resultEnum = "Cancelled"
			outcome.message = "Upload cancelled before this item started."
			return outcome
		end

		local started = time()
		local maxRetries = math.max(0, math.floor(self._options.MaxRetries))

		for attempt = 1, maxRetries + 1 do
			outcome.attempts = attempt
			if self._cancelled then
				outcome.resultEnum = "Cancelled"
				outcome.message = "Upload cancelled."
				break
			end

			self:WaitForSlot()

			if self._cancelled then
				outcome.resultEnum = "Cancelled"
				outcome.message = "Upload cancelled."
				break
			end

			-- Build the object we hand to the API.
			local target: Instance = sequence
			local clone: Instance? = nil
			if self._options.UploadMode == "Clone" then
				local cloneOk, cloned = pcall(function()
					return sequence:Clone()
				end)
				if not cloneOk or not cloned then
					outcome.resultEnum = "CloneFailed"
					outcome.message = "Could not clone the KeyframeSequence: " .. tostring(cloned)
					break
				end
				clone = cloned
				clone.Parent = nil -- standalone root, not part of the rig
				target = clone
			end

			local params: { [string]: any }? = nil
			local paramsOk, paramsErr = pcall(function()
				params = self:BuildParams(sequence, overrides)
			end)
			if not paramsOk then
				outcome.resultEnum = "InvalidParameters"
				outcome.message = tostring(paramsErr)
				if clone then
					clone:Destroy()
				end
				break
			end

			-- The actual upload. pcall because a disabled beta feature or a network
			-- failure raises a Lua error instead of returning a result enum.
			local ok, first, second = pcall(function()
				return AssetService:CreateAssetAsync(target, Enum.AssetType.Animation, params)
			end)

			if clone then
				clone:Destroy()
			end

			if not ok then
				outcome.resultEnum = "LuaError"
				outcome.message = tostring(first)

				if isBetaFeatureError(outcome.message) then
					outcome.resultEnum = "BetaDisabled"
					outcome.message = "CreateAssetAsync is not available. Enable the "
						.. "'CreateAssetAsync Luau API' beta feature in Studio "
						.. "(File -> Beta Features) and make sure this plugin is installed "
						.. "as a LOCAL plugin, not from the Creator Store."
					break -- retrying will never help
				end

				if attempt <= maxRetries then
					self:Log("warn", string.format("Upload of '%s' raised an error (attempt %d): %s", sequence.Name, attempt, outcome.message))
					task.wait(self._options.RetryDelaySeconds)
					continue
				end
				break
			end

			outcome.resultEnum = resultKey(first)

			if typeof(first) == "EnumItem" and first == Enum.CreateAssetResult.Success then
				if type(second) == "number" then
					outcome.success = true
					outcome.assetId = math.floor(second)
					outcome.message = string.format("Uploaded '%s' as asset %d.", sequence.Name, outcome.assetId)
				else
					outcome.resultEnum = "MalformedResult"
					outcome.message = string.format(
						"CreateAssetAsync reported Success but returned %s instead of an asset id.",
						typeof(second)
					)
				end
				break
			end

			-- Failure path: second is a diagnostic string.
			outcome.message = if type(second) == "string" then second else "Upload failed with no diagnostic."

			if outcome.resultEnum == "PermissionDenied" then
				-- Retrying will not help; the user must fix permissions.
				break
			end

			if attempt <= maxRetries then
				self:Log(
					"warn",
					string.format("Upload of '%s' failed with %s (attempt %d): %s", sequence.Name, outcome.resultEnum, attempt, outcome.message)
				)
				task.wait(self._options.RetryDelaySeconds)
			end
		end

		outcome.elapsed = time() - started
		return outcome
	end

	--------------------------------------------------------------------------------
	-- Batch upload
	--------------------------------------------------------------------------------

	export type BatchCallbacks = {
		onStart: ((total: number) -> ())?,
		onItemStart: ((index: number, total: number, record: any) -> ())?,
		onItemEnd: ((index: number, total: number, record: any, outcome: UploadOutcome) -> ())?,
		onProgress: ((index: number, total: number, record: any, outcome: UploadOutcome) -> ())?,
		onSkip: ((index: number, total: number, record: any, reason: string) -> ())?,
		onComplete: ((summary: BatchSummary) -> ())?,
		onLog: ((level: string, message: string) -> ())?,
	}

	export type BatchSummary = {
		total: number,
		succeeded: number,
		failed: number,
		skipped: number,
		cancelled: boolean,
		elapsed: number,
		results: { { record: any, outcome: UploadOutcome } },
	}

	--[[
		Uploads a list of AnalysisRecords produced by BinaryCacheService:Analyze().

		Behaviour
			* Records whose `.selected` is false are skipped.
			* Records that are Clean can be skipped entirely when `skipClean` is set;
			  this is the performance win the binary cache exists for.
			* Everything else is uploaded through AssetService:CreateAssetAsync.
			* Progress is reported after every item; the batch runs in whatever
			  coroutine calls it, so callers should `task.spawn` it.

		Returns a BatchSummary. Never throws.
	]]
	function UploadService:UploadBatch(records: { any }, callbacks: BatchCallbacks?, skipClean: boolean?): BatchSummary
		local summary: BatchSummary = {
			total = 0,
			succeeded = 0,
			failed = 0,
			skipped = 0,
			cancelled = false,
			elapsed = 0,
			results = {},
		}

		self._busy = true
		self._cancelled = false
		self._requestTimes = {}
		self._lastError = nil

		local started = time()

		local available, reason = self:IsAvailable()
		if not available then
			self._lastError = reason
			self:Log("error", reason or "Upload path unavailable.")
			if callbacks and callbacks.onComplete then
				callbacks.onComplete(summary)
			end
			self._busy = false
			return summary
		end

		-- Build the work list.
		local work: { any } = {}
		for _, record in ipairs(records or {}) do
			if record.selected then
				if skipClean and record.state == STATE_CLEAN then
					summary.skipped += 1
					if callbacks and callbacks.onSkip then
						callbacks.onSkip(#work + 1, #records, record, "unchanged since last upload")
					end
				else
					table.insert(work, record)
				end
			end
		end

		summary.total = #work
		if callbacks and callbacks.onStart then
			callbacks.onStart(summary.total)
		end

		if summary.total == 0 then
			summary.cancelled = self._cancelled
			summary.elapsed = time() - started
			if callbacks and callbacks.onComplete then
				callbacks.onComplete(summary)
			end
			self._busy = false
			return summary
		end

		for index, record in ipairs(work) do
			if self._cancelled then
				summary.cancelled = true
				break
			end

			if callbacks and callbacks.onItemStart then
				callbacks.onItemStart(index, summary.total, record)
			end

			local outcome = self:UploadOne(record.sequence, record.uploadOverrides)

			table.insert(summary.results, { record = record, outcome = outcome })

			if outcome.success then
				summary.succeeded += 1
				self:Log("info", outcome.message)
			else
				summary.failed += 1
				self._lastError = outcome.message
				self:Log("error", string.format("[%d/%d] %s", index, summary.total, outcome.message))
			end

			if callbacks and callbacks.onItemEnd then
				callbacks.onItemEnd(index, summary.total, record, outcome)
			end
			if callbacks and callbacks.onProgress then
				callbacks.onProgress(index, summary.total, record, outcome)
			end

			-- Let Studio paint.
			if index < summary.total then
				task.wait(self._options.InterItemDelay)
			end
		end

		summary.cancelled = self._cancelled
		summary.elapsed = time() - started

		if callbacks and callbacks.onComplete then
			callbacks.onComplete(summary)
		end

		self._busy = false
		return summary
	end

	--[[
		Runs :UploadBatch on a fresh coroutine so the calling (UI) thread is never
		blocked. Returns the thread.
	]]
	function UploadService:UploadBatchAsync(records: { any }, callbacks: BatchCallbacks?, skipClean: boolean?): thread
		return task.spawn(function()
			self:UploadBatch(records, callbacks, skipClean)
		end)
	end

	--------------------------------------------------------------------------------
	-- Dry run (no network calls at all)
	--------------------------------------------------------------------------------

	--[[
		Simulates a batch so the whole pipeline (UI, progress, cache, registration)
		can be validated without spending the user's rate limit. Never calls
		CreateAssetAsync.
	]]
	function UploadService:DryRun(records: { any }, callbacks: BatchCallbacks?, skipClean: boolean?): BatchSummary
		local summary: BatchSummary = {
			total = 0,
			succeeded = 0,
			failed = 0,
			skipped = 0,
			cancelled = false,
			elapsed = 0,
			results = {},
		}

		local started = time()
		local work: { any } = {}
		for _, record in ipairs(records or {}) do
			if record.selected then
				if skipClean and record.state == STATE_CLEAN then
					summary.skipped += 1
					if callbacks and callbacks.onSkip then
						callbacks.onSkip(#work + 1, #records, record, "unchanged since last upload (dry run)")
					end
				else
					table.insert(work, record)
				end
			end
		end

		summary.total = #work
		if callbacks and callbacks.onStart then
			callbacks.onStart(summary.total)
		end

		for index, record in ipairs(work) do
			local outcome: UploadOutcome = {
				success = true,
				assetId = 900000000 + index,
				resultEnum = "Success (dry run)",
				message = string.format("Dry run: would upload '%s'.", record.name),
				attempts = 1,
				elapsed = 0,
				sequence = record.sequence,
				name = record.name,
			}
			summary.succeeded += 1
			table.insert(summary.results, { record = record, outcome = outcome })

			if callbacks and callbacks.onItemEnd then
				callbacks.onItemEnd(index, summary.total, record, outcome)
			end
			if callbacks and callbacks.onProgress then
				callbacks.onProgress(index, summary.total, record, outcome)
			end
			task.wait(0.02)
		end

		summary.elapsed = time() - started
		if callbacks and callbacks.onComplete then
			callbacks.onComplete(summary)
		end
		return summary
	end

	return UploadService

end

Modules["RegistrationService"] = function(require)
	--[[
		RegistrationService.luau
		------------------------
		Module 3 of 6 - the registration module.

		For every successfully uploaded animation this module writes the result back
		into the rig so the ids are never lost:

			<rig>
			 └─ UploadedAnimations            (Folder, created if missing)
			      ├─ <AnimationName>           (StringValue, .Value = asset id)
			      ├─ <AnimationName>           (StringValue, .Value = asset id)
			      └─ ...

		Rules
			* The folder is named exactly "UploadedAnimations" and lives directly
			  inside the rig.
			* Each StringValue is named after the animation and its .Value holds the
			  asset id.
			* Re-uploading an animation updates the existing StringValue instead of
			  creating a duplicate, so the folder never accumulates stale entries.
			* Nothing is ever destroyed unless the caller explicitly asks for it.

		The plugin's own binary cache StringValue lives in a *separate* folder
		("_AnimUploaderCache") so registration and caching never fight over children.
	]]

	local RegistrationService = {}
	RegistrationService.__index = RegistrationService

	RegistrationService.Defaults = {
		-- Name of the folder created inside the rig.
		FolderName = "UploadedAnimations",

		-- "Numeric" -> StringValue.Value = "13164837337"
		-- "Content"  -> StringValue.Value = "rbxassetid://13164837337"
		ValueFormat = "Numeric",

		-- When a child with the animation's name already exists but is NOT a
		-- StringValue (e.g. an old Animation object), replace it. Off by default so
		-- the plugin never silently destroys user data.
		ReplaceMismatchedClasses = false,

		-- Optionally tag the rig and stamp the folder with attributes.
		TagRig = true,
		StampFolderAttributes = true,

		-- Optional: also drop an Animation instance next to each StringValue.
		-- Off by default; StringValues are what the spec asks for.
		AlsoCreateAnimationObjects = false,
	}

	export type RegistrationResult = {
		name: string,
		assetId: number,
		value: string,
		action: string, -- "created" | "updated" | "skipped" | "failed"
		instance: StringValue?,
		error: string?,
	}

	--------------------------------------------------------------------------------
	-- Construction
	--------------------------------------------------------------------------------

	function RegistrationService.new(options: { [string]: any }?): RegistrationService
		local self = setmetatable({}, RegistrationService)
		self._options = {}
		for key, value in pairs(RegistrationService.Defaults) do
			self._options[key] = value
		end
		if options then
			for key, value in pairs(options or {}) do
				self._options[key] = value
			end
		end
		self._written = {} -- { [string]: StringValue }
		return self
	end

	function RegistrationService:SetOptions(options: { [string]: any })
		for key, value in pairs(options or {}) do
			self._options[key] = value
		end
		return self
	end

	--------------------------------------------------------------------------------
	-- Folder management
	--------------------------------------------------------------------------------

	--[[
		Returns the `UploadedAnimations` folder inside `rig`, creating it if needed.

		If an existing child has the right name but the wrong class it is left alone
		and an error is raised - we never destroy something we did not create.
	]]
	function RegistrationService:EnsureFolder(rig: Instance): Folder
		if not rig then
			error("RegistrationService:EnsureFolder requires a rig.", 2)
		end

		local existing = rig:FindFirstChild(self._options.FolderName)
		if existing then
			if existing:IsA("Folder") then
				if self._options.StampFolderAttributes then
					self:_stampFolder(existing :: Folder)
				end
				return existing :: Folder
			end
			error(
				string.format(
					"'%s' already exists as a %s and cannot be used as the animation folder.",
					self._options.FolderName,
					existing.ClassName
				),
				2
			)
		end

		local folder = Instance.new("Folder")
		folder.Name = self._options.FolderName
		folder.Parent = rig

		if self._options.StampFolderAttributes then
			self:_stampFolder(folder)
		end

		if self._options.TagRig then
			pcall(function()
				rig:AddTag("AnimSavesUploaded")
			end)
		end

		return folder
	end

	function RegistrationService:_stampFolder(folder: Folder)
		pcall(function()
			folder:SetAttribute("CreatedBy", "AnimSaves Bulk Uploader")
			folder:SetAttribute("LastUpdated", os.time())
		end)
	end

	--[[
		Returns the folder if it already exists, without creating anything.
	]]
	function RegistrationService:FindFolder(rig: Instance): Folder?
		if not rig then
			return nil
		end
		local existing = rig:FindFirstChild(self._options.FolderName)
		if existing and existing:IsA("Folder") then
			return existing :: Folder
		end
		return nil
	end

	--------------------------------------------------------------------------------
	-- Value formatting
	--------------------------------------------------------------------------------

	function RegistrationService:FormatValue(assetId: number): string
		if self._options.ValueFormat == "Content" then
			return "rbxassetid://" .. tostring(math.floor(assetId))
		end
		return tostring(math.floor(assetId))
	end

	--------------------------------------------------------------------------------
	-- Single registration
	--------------------------------------------------------------------------------

	--[[
		Creates or updates the StringValue for one uploaded animation.

		Returns a RegistrationResult describing what happened. Never throws.
	]]
	function RegistrationService:Register(rig: Instance, name: string, assetId: number): RegistrationResult
		local result: RegistrationResult = {
			name = name,
			assetId = math.floor(assetId),
			value = self:FormatValue(assetId),
			action = "failed",
			instance = nil,
			error = nil,
		}

		if not rig then
			result.error = "No rig supplied."
			return result
		end
		if type(name) ~= "string" or #name == 0 then
			result.error = "Animation name is empty."
			return result
		end
		if type(assetId) ~= "number" or assetId <= 0 then
			result.error = string.format("Invalid asset id %s for '%s'.", tostring(assetId), name)
			return result
		end

		local ok, err = pcall(function()
			local folder = self:EnsureFolder(rig)

			-- Prefer the instance we already wrote this session (handles duplicate
			-- animation names inside the same rig deterministically).
			local value: StringValue? = self._written[name]
			if value and value.Parent ~= folder then
				value = nil
			end

			if not value then
				local existing = folder:FindFirstChild(name)
				if existing then
					if existing:IsA("StringValue") then
						value = existing :: StringValue
						result.action = "updated"
					elseif self._options.ReplaceMismatchedClasses then
						existing:Destroy()
						warn(string.format("[AnimSavesUploader] Replaced '%s' (%s) with a StringValue.", name, existing.ClassName))
					else
						error(
							string.format(
								"'%s' already exists as a %s inside %s. Enable ReplaceMismatchedClasses to overwrite it.",
								name,
								existing.ClassName,
								folder:GetFullName()
							),
							0
						)
					end
				end
			else
				result.action = "updated"
			end

			if not value then
				value = Instance.new("StringValue")
				value.Name = name
				result.action = "created"
			end

			value.Value = result.value
			value.Parent = folder

			-- Optional convenience: an Animation instance carrying the same id.
			if self._options.AlsoCreateAnimationObjects then
				local anim = folder:FindFirstChild(name .. "_Animation")
				if not anim then
					anim = Instance.new("Animation")
					anim.Name = name .. "_Animation"
					anim.Parent = folder
				end
				(anim :: Animation).AnimationId = result.value
			end

			self._written[name] = value
			result.instance = value
		end)

		if not ok then
			result.action = "failed"
			result.error = tostring(err)
			warn("[AnimSavesUploader] Registration failed for '" .. tostring(name) .. "': " .. tostring(err))
			return result
		end

		return result
	end

	--------------------------------------------------------------------------------
	-- Batch registration
	--------------------------------------------------------------------------------

	--[[
		Registers every successful upload from an UploadService batch summary.

		Accepts either an UploadService BatchSummary ({ results = { {record, outcome} } })
		or a plain array of { name = ..., assetId = ... } rows.

		Returns { registered, updated, skipped, failed, results }.
	]]
	function RegistrationService:RegisterBatch(rig: Instance, batch: any): {
		registered: number,
		updated: number,
		skipped: number,
		failed: number,
		results: { RegistrationResult },
	}
		local tally = { registered = 0, updated = 0, skipped = 0, failed = 0, results = {} }

		if not rig then
			warn("[AnimSavesUploader] RegisterBatch called without a rig.")
			return tally
		end

		local rows: { { name: string, assetId: number } } = {}

		if type(batch) == "table" and type(batch.results) == "table" then
			for _, item in ipairs(batch.results) do
				local outcome = item.outcome
				if outcome and outcome.success and outcome.assetId and outcome.assetId > 0 then
					table.insert(rows, { name = outcome.name or (item.record and item.record.name) or "Unknown", assetId = outcome.assetId })
				end
			end
		elseif type(batch) == "table" then
			for _, item in ipairs(batch) do
				if type(item) == "table" and item.assetId and item.assetId > 0 then
					table.insert(rows, { name = item.name or "Unknown", assetId = item.assetId })
				end
			end
		end

		for _, row in ipairs(rows) do
			local result = self:Register(rig, row.name, row.assetId)
			table.insert(tally.results, result)
			if result.action == "created" then
				tally.registered += 1
			elseif result.action == "updated" then
				tally.updated += 1
			else
				tally.failed += 1
			end
		end

		return tally
	end

	--------------------------------------------------------------------------------
	-- Reading back / reconciliation
	--------------------------------------------------------------------------------

	--[[
		Returns a map of animation name -> asset id read from the existing
		`UploadedAnimations` folder. Used to cross-check the binary cache.
	]]
	function RegistrationService:GetExistingIds(rig: Instance): { [string]: number }
		local ids: { [string]: number } = {}
		local folder = self:FindFolder(rig)
		if not folder then
			return ids
		end
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("StringValue") then
				local digits = child.Value:match("(%d+)%s*$")
				if digits then
					ids[child.Name] = tonumber(digits) or 0
				end
			end
		end
		return ids
	end

	--[[
		Cross-checks the registration folder against a list of cache records and
		marks each record VERIFIED when the folder agrees with the cache.

		Returns the number of records that could be verified. This is what turns the
		binary cache's FLAG_VERIFIED bit on.
	]]
	function RegistrationService:Reconcile(rig: Instance, records: { any }): number
		local existing = self:GetExistingIds(rig)
		local verified = 0

		for _, record in ipairs(records or {}) do
			local folderId = existing[record.name]
			if folderId and folderId > 0 and record.cachedAssetId and folderId == record.cachedAssetId then
				record.flags = bit32.bor(record.flags, 4) -- FLAG_VERIFIED
				verified += 1
			elseif folderId and folderId > 0 and record.cachedAssetId and folderId ~= record.cachedAssetId then
				-- The folder is newer than the cache: trust the folder and refresh
				-- the record so the next upload decision uses the right id.
				record.cachedAssetId = folderId
				record.flags = bit32.bor(record.flags, 4)
				verified += 1
			end
		end

		return verified
	end

	--------------------------------------------------------------------------------
	-- Cleanup
	--------------------------------------------------------------------------------

	--[[
		Empties the `UploadedAnimations` folder (but keeps the folder itself).
		Only ever called from an explicit user action.
	]]
	function RegistrationService:ClearFolder(rig: Instance): number
		local folder = self:FindFolder(rig)
		if not folder then
			return 0
		end
		local removed = 0
		for _, child in ipairs(folder:GetChildren()) do
			child:Destroy()
			removed += 1
		end
		self._written = {}
		return removed
	end

	--[[
		Forgets the session's instance cache. Call this when the rig changes so stale
		StringValue references are never reused.
	]]
	function RegistrationService:ResetSession()
		self._written = {}
		return self
	end

	return RegistrationService

end

Modules["UIController"] = function(require)
	--[[
		UIController.luau
		-----------------
		Module 4 of 6 - the plugin UI.

		A single DockWidgetPluginGui built entirely at runtime (no .rbxmodel asset, so
		the whole plugin is one folder of source files). Styling is a dark "terminal"
		theme: near-black panels, neon green accents, monospace font, and a
		block-letter ASCII banner that is exactly 31 cells wide so it never wraps.

		Layout
			┌─ header: ASCII banner + subtitle + rig/container status
			├─ target rig: picker button, container class, alias, rescan
			├─ stat chips: total / dirty / clean / selected
			├─ filter row: search box, select all/none/invert, dirty-only
			├─ animation list: scrolling rows with checkbox, badge, metadata
			├─ progress: bar + counters + status line
			├─ log: scrolling monospace log
			├─ footer: Upload Selected, dry run, options
			└─ options: cache backend, hash mode, creator, skip-clean, auto-reupload

		All list mutation happens on the main thread through small helper methods;
		the heavy work (scanning, hashing, uploading) runs in coroutines so the UI
		never blocks.
	]]

	local TweenService = game:GetService("TweenService")
	local Selection = game:GetService("Selection")

