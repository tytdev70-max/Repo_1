--[[
	Auto-generated by build_plugin.py -- DO NOT EDIT BY HAND.
	Source of truth: Plugin/MainPlugin.luau + Plugin/Modules/*.luau

	AnimSaves Bulk Uploader, folded into one file so it can be pasted into a
	Script instance and saved as a local plugin.

	INSTALL (see Plugin/INSTALL.md for the full walkthrough):
		1. In Roblox Studio, insert a **Script** (not a LocalScript, not a
		   ModuleScript) anywhere in your place, e.g. ServerScriptService.
		2. Replace its entire contents with this file.
		3. Right-click the Script in the Explorer -> "Save to File..." and put the
		   resulting .rbxmx into your local Plugins folder, then restart Studio.

	AssetService:CreateAssetAsync is unavailable to Creator Store plugins, so
	this must be installed locally.
]]

--------------------------------------------------------------------------------
-- Inline module registry + require shim
--------------------------------------------------------------------------------

local Modules: { [string]: any } = {}
local loaded: { [string]: any } = {}
local loading: { [string]: boolean } = {}

local function require(name: string): any
	if loaded[name] ~= nil then
		return loaded[name]
	end
	local factory = Modules[name]
	if not factory then
		error(string.format("AnimSaves Bulk Uploader: unknown module '%s'", tostring(name)), 2)
	end
	-- Circular-require guard: hand back the partial table rather than
	-- recursing forever. Mirrors Roblox's own behaviour.
	if loading[name] then
		return Modules[name]
	end
	loading[name] = true
	local result = factory(require)
	loading[name] = nil
	loaded[name] = result
	return result
end

